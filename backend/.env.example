# AgentForge AI Operating System Configuration
# Copy this file to `.env` in the backend directory and adjust values for your environment.

PROJECT_NAME=AgentForge
API_V1_STR=/api/v1

# Required outside development. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ENVIRONMENT=development
SECRET_KEY=

# Database (SQLite for local dev, PostgreSQL for Docker/production)
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agentforge

ACCESS_TOKEN_EXPIRE_MINUTES=11520
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WORKSPACE_ROOT=repos
ENABLE_TERMINAL=false

# Redis (Background processing)
REDIS_URL=redis://localhost:6379/0

# Qdrant vector store (RAG)
QDRANT_URL=http://localhost:6333

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ===================================================================
# AI OPERATING SYSTEM CONFIGURATION
# ===================================================================

# Primary LLM Provider (AI OS will intelligently route based on task)
DEFAULT_AI_PROVIDER=ollama

# Provider API Keys (configure at least one)
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here  
CLAUDE_API_KEY=your_claude_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Unified API Providers (Recommended for production)
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Local Models (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# AI Operating System Intelligence Settings
# ========================================
ENABLE_INTELLIGENT_ROUTING=true
ENABLE_PROVIDER_FALLBACK=true
ENABLE_COST_OPTIMIZATION=true
ENABLE_LATENCY_OPTIMIZATION=true

# Model Selection Preferences
PREFER_FAST_MODELS_FOR_CHAT=true
PREFER_POWERFUL_MODELS_FOR_ANALYSIS=true
PREFER_LOCAL_MODELS_WHEN_AVAILABLE=false

# Performance and Limits
# ======================
DEFAULT_MODEL_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4000
MAX_CONTEXT_TOKENS=100000
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRY_ATTEMPTS=3

# Cost Management
# ==============
ENABLE_COST_TRACKING=true
DAILY_COST_LIMIT=100.0
TOKEN_USAGE_ALERTS=true

# RAG Configuration
# ================
EMBEDDING_DIMENSION=1536
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

# Security and Safety
# ==================
ENABLE_CONTENT_FILTERING=true
ENABLE_INPUT_VALIDATION=true
MAX_INPUT_LENGTH=50000

# Development Settings
# ===================
AI_OS_DEBUG_MODE=false
LOG_AI_REQUESTS=true
LOG_AI_RESPONSES=false

# ===================================================================
# PHASE 2 — REAL-TIME AI OPERATING SYSTEM CONFIGURATION
# ===================================================================

# Celery Background Processing
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=900
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF=5

# WebSocket Engine
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_USER=5
WS_RATE_LIMIT_PER_MINUTE=60
WS_REDIS_CHANNEL_PREFIX=agentforge:ws:

# Job Management
JOB_HISTORY_RETENTION_DAYS=30
JOB_CLEANUP_INTERVAL_HOURS=24

# Observability
WORKER_HEARTBEAT_TIMEOUT_SECONDS=90
METRICS_RETENTION_HOURS=24

# Frontend Configuration
# =====================
# Set this in your frontend or hosting configuration:
# window.__AGENTFORGE_API_BASE_URL__ = 'http://localhost:8000'
